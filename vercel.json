{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "build": {
    "env": {
      "VERCEL_EXPERIMENTAL_BACKENDS": "1"
    }
  },
  "services": {
    "app": {
      "root": ".",
      "framework": "hono"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "bun run build && bun run --cwd ../admin build:nested",
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/admin/index.html"
        },
        {
          "source": "/admin/(.*)",
          "destination": "/admin/index.html"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
