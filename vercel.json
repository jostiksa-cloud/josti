{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "build": {
    "env": {
      "VERCEL_EXPERIMENTAL_BACKENDS": "1"
    }
  },
  "services": {
    "app": {
      "root": ".",
      "framework": "hono"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
