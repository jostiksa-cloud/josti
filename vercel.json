{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "hono"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
