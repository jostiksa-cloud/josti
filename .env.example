# JOSTI configuration template
# Copy this file to .env and replace every blank or placeholder.
# Leave a value empty to keep the local fallback. Never commit the filled .env.
#
# What you fill in to leave the local demo:
# - DATABASE_URL + DATABASE_MODE=postgres for Supabase or any PostgreSQL
# - SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_STORAGE_BUCKET for private files
# - MAP_TILE_URL if you switch away from OpenStreetMap (no key required for the default)
# - FCM_* and APNS_* for phone push. Both stay off while empty.
# - SMTP_* for password-reset email
# - ADMIN_EMAIL and ADMIN_PASSWORD, then: bun scripts/create-admin.ts
#
# Google Maps is not called by this release. Do not put a Google key in the client.
# When a Google map provider is approved, set MAP_TILE_URL to that provider's
# {z}/{x}/{y} tile endpoint, or add GOOGLE_MAPS_API_KEY only after the app is
# changed to read it on the server.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:5173
ADMIN_URL=http://127.0.0.1:5174
API_PUBLIC_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# postgres = Supabase or any PostgreSQL. pglite = embedded development database only.
DATABASE_MODE=pglite
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Minimum 32 characters. Do not use this placeholder.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

STORAGE_LOCAL_DIR=./data/storage
# Supabase connection. Fill these in .env, then say the file is ready.
# Do not send the service role key in a public channel; the local .env is enough.
# From Project Settings → Database, copy the URI (Session pooler is fine):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# From Project Settings → API:
#   Project URL, anon public key, and service_role key (server only).
# Create a private Storage bucket named josti-private. Do not make it public.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=josti-private

MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Push stays disabled until real provider credentials exist.
FCM_SERVER_KEY=
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Development only. Never enable in production.
ALLOW_DEV_RESET_TOKEN=false

ARGON_MEMORY_COST=19456
JOB_INTERVAL_MS=60000
TRUST_PROXY=false

# Used only by scripts/create-admin.ts. Not a default login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=JOSTI Administrator
ADMIN_PERMISSIONS=general
